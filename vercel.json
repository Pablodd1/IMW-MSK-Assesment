{
  "regions": ["iad1"],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/test", "destination": "/api/health" },
    { "source": "/info", "destination": "/api" },
    { "source": "/patients(.*)", "destination": "/api" }
  ]
}
