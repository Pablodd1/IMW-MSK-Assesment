{
  "regions": ["iad1"],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/capture", "destination": "/api/capture" },
    { "source": "/progress", "destination": "/api/capture" },
    { "source": "/gait", "destination": "/api/capture" },
    { "source": "/health", "destination": "/api/capture" },
